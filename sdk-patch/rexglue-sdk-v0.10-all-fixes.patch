+namespace {
+// RR-NR-10: wait until the guest tick count reaches `target`: a high-resolution waitable timer to
+// ~1 ms before, then a spin. The 1 ms Sleep poll fired vblanks 0-3 ms late, so the game's frames
+// (which wait for the vblank) read 13-20 ms around 16.7.
+void PreciseWaitGuestTicks(uint64_t target, uint64_t frequency) {
+  const uint64_t now = chrono::Clock::QueryGuestTickCount();
+  if (now >= target)
+    return;
+  const double remaining_ms = double(target - now) * 1000.0 / double(frequency);
+#if defined(_WIN32)
+  static HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr,
+                                               CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                               TIMER_ALL_ACCESS);
+  if (remaining_ms > 1.5) {
+    LARGE_INTEGER due;
+    due.QuadPart = -static_cast<LONGLONG>((remaining_ms - 1.0) * 10000.0);
+    if (timer && SetWaitableTimerEx(timer, &due, 0, nullptr, nullptr, nullptr, 0))
+      WaitForSingleObject(timer, INFINITE);
+    else
+      rex::thread::Sleep(std::chrono::milliseconds(1));
+  }
