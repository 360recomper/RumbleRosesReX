+bool XmaContext::DecodeCustomFrame(XMA_CONTEXT_DATA* data, uint32_t padding_start,
+                                   uint32_t frame_size, bool is_loop_end_frame) {
+  // Frame bits start after the PreparePacket byte and the copy's lead-in bits.
+  const uint8_t* bits = xma_frame_.data();
+  size_t pos = 8 + padding_start + kBitsPerFrameHeader;
+  const size_t end = 8 + padding_start + frame_size;
+  auto read = [&](uint32_t n) -> uint32_t {
+    uint32_t v = 0;
+    for (uint32_t i = 0; i < n; i++, pos++) {
+      v = (v << 1) | ((bits[pos >> 3] >> (7 - (pos & 7))) & 1);
+    }
+    return v;
+  };
+  if (frame_size < kBitsPerFrameHeader + 40 || read(32) != kCustomFrameMagic) {
+    return false;
+  }
+
+  // Header: codec:4 (1 = IMA ADPCM, 2 = linear PCM), channels:4, then per codec.
+  const uint32_t codec = read(4);
+  const uint32_t channels = read(4);
+  static std::atomic<uint32_t> logged{0};
+  if (logged.fetch_add(1) == 0) {
+    REXAPU_INFO("XmaContext {}: custom RRXA audio stream (codec {}, {} ch)", id(), codec, channels);
+  }
+  const uint32_t out_channels = data->is_stereo ? 2 : 1;
+  std::array<int16_t, kSamplesPerFrame * 2> pcm{};
+
+  if (codec == 1 && (channels == 1 || channels == 2) &&
+      pos + channels * 23 + kSamplesPerFrame * channels * 4 <= end) {
+    static const int16_t kSteps[89] = {
+        7,     8,     9,     10,    11,    12,    13,    14,    16,    17,    19,    21,    23,
+        25,    28,    31,    34,    37,    41,    45,    50,    55,    60,    66,    73,    80,
+        88,    97,    107,   118,   130,   143,   157,   173,   190,   209,   230,   253,   279,
+        307,   337,   371,   408,   449,   494,   544,   598,   658,   724,   796,   876,   963,
