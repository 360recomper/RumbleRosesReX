+bool XmaContext::DecodeCustomFrame(XMA_CONTEXT_DATA* data, uint32_t padding_start,
+                                   uint32_t frame_size, bool is_loop_end_frame) {
+  // Frame bits start after the PreparePacket byte and the copy's lead-in bits.
+  const uint8_t* bits = xma_frame_.data();
+  size_t pos = 8 + padding_start + kBitsPerFrameHeader;
+  const size_t end = 8 + padding_start + frame_size;
+  auto read = [&](uint32_t n) -> uint32_t {
+    uint32_t v = 0;
+    for (uint32_t i = 0; i < n; i++, pos++) {
+      v = (v << 1) | ((bits[pos >> 3] >> (7 - (pos & 7))) & 1);
+    }
+    return v;
+  };
+  if (frame_size < kBitsPerFrameHeader + 40 || read(32) != kCustomFrameMagic) {
+    return false;
+  }
+
+  // Header: codec:4 (1 = IMA ADPCM, 2 = linear PCM), channels:4, then per codec.
+  const uint32_t codec = read(4);
+  const uint32_t channels = read(4);
+  static std::atomic<uint32_t> logged{0};
+  if (logged.fetch_add(1) == 0) {
+    REXAPU_INFO("XmaContext {}: custom RRXA audio stream (codec {}, {} ch)", id(), codec, channels);
+  }
+  const uint32_t out_channels = data->is_stereo ? 2 : 1;
+  std::array<int16_t, kSamplesPerFrame * 2> pcm{};
+
+  if (codec == 1 && (channels == 1 || channels == 2) &&
+      pos + channels * 23 + kSamplesPerFrame * channels * 4 <= end) {
+    static const int16_t kSteps[89] = {
+        7,     8,     9,     10,    11,    12,    13,    14,    16,    17,    19,    21,    23,
+        25,    28,    31,    34,    37,    41,    45,    50,    55,    60,    66,    73,    80,
+        88,    97,    107,   118,   130,   143,   157,   173,   190,   209,   230,   253,   279,
+        307,   337,   371,   408,   449,   494,   544,   598,   658,   724,   796,   876,   963,
+        1060,  1166,  1282,  1411,  1552,  1707,  1878,  2066,  2272,  2499,  2749,  3024,  3327,
+        3660,  4026,  4428,  4871,  5358,  5894,  6484,  7132,  7845,  8630,  9493,  10442, 11487,
+        12635, 13899, 15289, 16818, 18500, 20350, 22385, 24623, 27086, 29794, 32767};
+    static const int8_t kIndexAdjust[8] = {-1, -1, -1, -1, 2, 4, 6, 8};
+    int32_t pred[2], index[2];
+    for (uint32_t c = 0; c < channels; c++) {
+      pred[c] = static_cast<int16_t>(read(16));
+      index[c] = std::min<int32_t>(read(7), 88);
+    }
+    for (uint32_t s = 0; s < kSamplesPerFrame; s++) {
+      for (uint32_t c = 0; c < channels; c++) {
+        const uint32_t n = read(4);
+        const int32_t step = kSteps[index[c]];
+        int32_t diff = step >> 3;
+        if (n & 1) diff += step >> 2;
+        if (n & 2) diff += step >> 1;
+        if (n & 4) diff += step;
+        pred[c] = std::clamp<int32_t>((n & 8) ? pred[c] - diff : pred[c] + diff, -32768, 32767);
+        index[c] = std::clamp<int32_t>(index[c] + kIndexAdjust[n & 7], 0, 88);
+        pcm[s * 2 + c] = static_cast<int16_t>(pred[c]);
+      }
+      if (channels == 1) pcm[s * 2 + 1] = pcm[s * 2];
+    }
+  } else if (codec == 2 && (channels == 1 || channels == 2)) {
+    const uint32_t sample_bits = read(4) + 1;
+    if (sample_bits >= 8 && pos + kSamplesPerFrame * channels * sample_bits <= end) {
+      for (uint32_t s = 0; s < kSamplesPerFrame; s++) {
+        for (uint32_t c = 0; c < channels; c++) {
+          pcm[s * 2 + c] = static_cast<int16_t>(read(sample_bits) << (16 - sample_bits));
+        }
+        if (channels == 1) pcm[s * 2 + 1] = pcm[s * 2];
+      }
+    } else {
+      REXAPU_ERROR("XmaContext {}: bad custom PCM frame", id());
+    }
+  } else {
+    REXAPU_ERROR("XmaContext {}: bad custom frame (codec {}, channels {})", id(), codec, channels);
+  }
+
+  // Output: big-endian s16, interleaved when the context is stereo. Unlike
+  // ffmpeg there is no decoder delay, so the frame goes out right away.
+  auto out = reinterpret_cast<uint16_t*>(raw_frame_.data());
+  for (uint32_t s = 0; s < kSamplesPerFrame; s++) {
+    if (out_channels == 2) {
+      out[s * 2] = rex::byte_swap(static_cast<uint16_t>(pcm[s * 2]));
+      out[s * 2 + 1] = rex::byte_swap(static_cast<uint16_t>(pcm[s * 2 + 1]));
+    } else {
+      out[s] = rex::byte_swap(static_cast<uint16_t>((pcm[s * 2] + pcm[s * 2 + 1]) / 2));
+    }
+  }
+
+  carry_valid_ = false;
+  current_frame_remaining_subframes_ = 4 << data->is_stereo;
+  loop_frame_output_limit_ =
+      is_loop_end_frame ? static_cast<uint8_t>((data->loop_subframe_end + 1) << data->is_stereo) : 0;
+  if (loop_start_skip_pending_) {
+    current_frame_remaining_subframes_ -= std::min<uint8_t>(
+        static_cast<uint8_t>(data->loop_subframe_skip << data->is_stereo),
+        current_frame_remaining_subframes_);
+    loop_start_skip_pending_ = false;
+  }
+  return true;
+}
