+static bool ShouldSeedEmptySaveFile(const XCONTENT_AGGREGATE_DATA& data) {
+  return data.content_type == XContentType::kSavedGame && data.file_name() == "Game Play Data";
+}
+
+static X_RESULT SeedEmptySaveFileIfMissing(const std::filesystem::path& package_path,
+                                           const XCONTENT_AGGREGATE_DATA& data) {
+  if (!ShouldSeedEmptySaveFile(data)) {
+    return X_ERROR_SUCCESS;
+  }
+
+  auto file_path = package_path / "savegame.txt";
+  if (std::filesystem::exists(file_path)) {
+    return X_ERROR_SUCCESS;
+  }
+
+  std::error_code ec;
+  std::filesystem::create_directories(file_path.parent_path(), ec);
+  if (ec) {
+    return X_ERROR_ACCESS_DENIED;
+  }
+
+  REXSYS_DEBUG("XContent seed file: file='{}', path={}", data.file_name(), file_path.string());
+  return rex::filesystem::CreateEmptyFile(file_path) ? X_ERROR_SUCCESS : X_ERROR_ACCESS_DENIED;
+}
