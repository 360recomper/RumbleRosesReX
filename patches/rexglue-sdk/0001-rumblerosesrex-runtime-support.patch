+const char* GetDeviceRemovedReasonName(HRESULT reason) {
+  switch (reason) {
+    case DXGI_ERROR_DEVICE_HUNG:
+      return "DEVICE_HUNG (TDR - GPU command took too long)";
+    case DXGI_ERROR_DEVICE_REMOVED:
+      return "DEVICE_REMOVED (driver internal error or hot-unplug)";
+    case DXGI_ERROR_DEVICE_RESET:
+      return "DEVICE_RESET (bad GPU command)";
+    case DXGI_ERROR_DRIVER_INTERNAL_ERROR:
+      return "DRIVER_INTERNAL_ERROR";
+    case DXGI_ERROR_INVALID_CALL:
+      return "INVALID_CALL";
+    default:
+      return "Unknown";
+  }
+}
+
+void LogPresentDeviceLoss(ID3D12Device* device, HRESULT present_result) {
+  HRESULT removed_reason = device ? device->GetDeviceRemovedReason() : present_result;
+  REXLOG_ERROR(
+      "D3D12Presenter: Present failed with HRESULT 0x{:08X}; device removed reason 0x{:08X} - {}",
+      static_cast<unsigned>(present_result), static_cast<unsigned>(removed_reason),
+      GetDeviceRemovedReasonName(removed_reason));
+}
+
