index f9eac23..7736cc0 100644
--- a/src/system/runtime.cpp
+++ b/src/system/runtime.cpp
@@ -311,9 +311,27 @@ bool Runtime::SetupVfs() {
     REXSYS_DEBUG("  Registered NullDevice for \\Device\\Harddisk0\\{{Partition0,Cache0,Cache1}}");
   }
 
-  // NOTE: Do NOT register a device for cache: paths
-  // Games handle "device not found" gracefully but don't handle actual device
-  // errors (like NAME_COLLISION) well. Let cache: fail cleanly.
+  // Give title-level scratch devices a real writable backing store. Many games
+  // tolerate missing CACHE:/PHOTO:, but some use them for save/load probes.
+  const auto scratch_root = std::filesystem::absolute(
+      cache_root_.empty() ? (user_data_root_ / "cache") : cache_root_);
+
+  auto mount_scratch_device = [&](const std::string_view guest_name,
+                                  const std::string_view device_path,
+                                  const std::filesystem::path& host_path) {
+    auto scratch_device =
+        std::make_unique<rex::filesystem::HostPathDevice>(device_path, host_path, false);
+    if (!scratch_device->Initialize()) {
+      REXSYS_WARN("  Failed to mount {} scratch at {}", guest_name, host_path.string());
+      return;
+    }
+    file_system_->RegisterDevice(std::move(scratch_device));
+    file_system_->RegisterSymbolicLink(guest_name, device_path);
+    REXSYS_INFO("  Mounted {} scratch at {}", guest_name, host_path.string());
+  };
+
+  mount_scratch_device("cache:", "\\Device\\Cache0", scratch_root / "xbox_cache");
+  mount_scratch_device("photo:", "\\Device\\Photo0", scratch_root / "photo");
 
   return true;
 }
